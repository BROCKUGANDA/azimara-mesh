# Copy to .env for local development. Never commit a populated .env.
# Start the isolated Postgres service with:
#   docker compose -f deploy/postgres/compose.yaml up -d
# DATABASE_URL must use the restricted mesh_app role. DATABASE_MIGRATION_URL
# is only for migration/backup tooling and must never be passed to the app.
DATABASE_URL="postgresql://mesh_app:replace-me@127.0.0.1:55432/mesh?schema=public"
DATABASE_MIGRATION_URL="postgresql://mesh_migrator:replace-me@127.0.0.1:55432/mesh?schema=public"
POSTGRES_ADMIN_PASSWORD=change-me
MESH_MIGRATOR_PASSWORD=change-me
MESH_APP_PASSWORD=change-me

# Onchain billing (Solana SPL USDC). Devnet is the default; mainnet requires
# SOLANA_CLUSTER=mainnet-beta and an explicit operator opt-in.
# SOLANA_TREASURY_ATA is the USDC token account that receives payments.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_TREASURY_WALLET=replace-with-treasury-wallet
SOLANA_TREASURY_ATA=replace-with-usdc-token-account
# MESH_PAY_PER_USE=1 permits work that will be settled onchain later.

# Required in production. Use >= 32 random bytes, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me

# Optional. Only enable for an embedded cross-site preview; it relaxes
# SameSite to None and therefore weakens CSRF protection.
# MESH_IFRAME_PREVIEW=1
